{
  "name": "m-design-agent-front",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8889 --strictPort",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.cjs",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build-dev": "vue-tsc --noEmit -p tsconfig.json && vite build && node scripts/package.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.51",
    "ai": "7.0.105",
    "vue": "3.4.38",
    "pinia": "2.1.7",
    "markdown-it": "15.0.2",
    "nanoid": "5.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.17.50",
    "@vitejs/plugin-vue": "^5.2.3",
    "jszip": "^3.10.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vue-tsc": "^2.2.8",
    "sass-embedded": "^1.89.0",
    "@types/markdown-it": "^14.1.2"
  }
}